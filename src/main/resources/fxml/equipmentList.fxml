<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane style="-fx-background-color: #EBF5EE;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="ui.controller.EquipmentListScreen">

   <top>
      <VBox style="-fx-background-color: #FFFFFF; -fx-border-color: #c8e6c9; -fx-border-width: 0 0 1 0;">
         <padding>
            <Insets bottom="16.0" left="28.0" right="28.0" top="16.0" />
         </padding>
         <children>
            <HBox alignment="CENTER_LEFT" spacing="12.0">
               <children>
                   <Label style="-fx-font-size: 20px; -fx-font-weight: 700; -fx-text-fill: #212121;" text="Equipment List" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Button fx:id="addEquipmentButton" mnemonicParsing="false" onAction="#handleAddEquipment"
                          prefHeight="36.0" prefWidth="140.0"
                          style="-fx-background-color: #283044; -fx-text-fill: white; -fx-font-size: 13px; -fx-background-radius: 6; -fx-cursor: hand;"
                          text="+ Add Equipment" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>

   <center>
      <VBox spacing="0.0" VBox.vgrow="ALWAYS">
         <padding>
            <Insets bottom="24.0" left="28.0" right="28.0" top="20.0" />
         </padding>
         <children>

            <!-- Search Bar -->
            <HBox alignment="CENTER_LEFT" spacing="12.0"
                  style="-fx-background-color: #FFFFFF; -fx-background-radius: 8; -fx-border-color: #c8e6c9; -fx-border-width: 1; -fx-border-radius: 8;">
               <padding>
                  <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
               </padding>
               <children>
                  <Label style="-fx-font-size: 13px; -fx-font-weight: 700; -fx-text-fill: #283044;" text="🔍" />
                  <TextField fx:id="searchField1" prefWidth="260.0" promptText="Search equipment..."
                             style="-fx-background-color: #EBF5EE; -fx-border-color: #c8e6c9; -fx-border-radius: 4; -fx-background-radius: 4; -fx-font-size: 13px;" />
                  <Region HBox.hgrow="ALWAYS" />
               </children>
            </HBox>

            <!-- Spacer -->
            <Region prefHeight="14.0" />

            <!-- Table -->
            <ScrollPane fitToHeight="true" fitToWidth="true" hbarPolicy="AS_NEEDED" vbarPolicy="NEVER"
                        style="-fx-background-color: transparent; -fx-border-color: transparent;" VBox.vgrow="ALWAYS">
               <content>
                  <TableView fx:id="unitsTable1"
                        style="-fx-background-color: #FFFFFF; -fx-border-color: #c8e6c9; -fx-border-width: 1; -fx-border-radius: 8; -fx-background-radius: 8;">
                     <columns>
                        <TableColumn fx:id="idColumn1" prefWidth="150.0" text="Equipment ID" />
                        <TableColumn fx:id="serialColumn1" prefWidth="180.0" text="Equipment Name" />
                        <TableColumn fx:id="equipmentColumn1" prefWidth="150.0" text="Brand" />
                        <TableColumn fx:id="addedByColumn1" prefWidth="150.0" text="Model" />
                        <TableColumn fx:id="addedByColumn11" prefWidth="220.0" text="Specifications" />
                        <TableColumn fx:id="statusColumn1" prefWidth="130.0" text="Category" />
                     </columns>
                     <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                     </columnResizePolicy>
                  </TableView>
               </content>
            </ScrollPane>

         </children>
      </VBox>
   </center>
</BorderPane>