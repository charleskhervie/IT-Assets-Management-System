                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                     <TableView fx:id="transactionSummaryTable">
                        <columns>
                           <TableColumn fx:id="transactionIdColumn" prefWidth="90.0" text="Transaction ID" />
                           <TableColumn fx:id="transactionUnitColumn" prefWidth="180.0" text="Unit" />
                           <TableColumn fx:id="transactionBorrowedByColumn" prefWidth="150.0" text="Borrowed By" />
                           <TableColumn fx:id="transactionProcessedByColumn" prefWidth="150.0" text="Processed By" />
                           <TableColumn fx:id="transactionBorrowDateColumn" prefWidth="120.0" text="Borrow Date" />
                           <TableColumn fx:id="transactionReturnDateColumn" prefWidth="120.0" text="Return Date" />
                           <TableColumn fx:id="transactionStatusColumn" prefWidth="110.0" text="Status" />
                           <TableColumn fx:id="transactionRemarksColumn" prefWidth="220.0" text="Remarks" />
                        </columns>
                     </TableView>
                  </children>
               </VBox>

               <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 10;">
                  <children>
                     <Label text="Usage Overview">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                     <PieChart fx:id="statusPieChart" prefHeight="280.0" />
