                        <children>
                           <Label text="Maintenance" />
                           <Label fx:id="maintenanceUnitsLabel" style="-fx-font-size: 24px; -fx-font-weight: 700;" text="0" />
                        </children>
                     </VBox>
                     <VBox style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 4; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="Transactions" />
                           <Label fx:id="transactionsLabel" style="-fx-font-size: 24px; -fx-font-weight: 700;" text="0" />
                        </children>
                     </VBox>
                  </children>
               </HBox>

               <HBox spacing="10.0">
                  <children>
                     <Region HBox.hgrow="ALWAYS" />
                     <Button fx:id="exportCsvButton" mnemonicParsing="false" onAction="#handleExportCsv" style="-fx-background-color: #2f7d32; -fx-text-fill: white;" text="Export CSV" />
                     <Button fx:id="exportJsonButton" mnemonicParsing="false" onAction="#handleExportJson" style="-fx-background-color: #2d6fb0; -fx-text-fill: white;" text="Export JSON" />
                     <Button fx:id="exportPdfButton" mnemonicParsing="false" onAction="#handleExportPdf" style="-fx-background-color: #b14646; -fx-text-fill: white;" text="Export PDF" />
