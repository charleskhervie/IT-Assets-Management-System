                           <TableColumn fx:id="categoryMaintenanceColumn" prefWidth="100.0" text="Maintenance" />
                        </columns>
                     </TableView>
                  </children>
               </VBox>

               <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 10;">
                  <children>
                     <Label text="Equipment Summary">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                     <TableView fx:id="equipmentSummaryTable">
                        <columns>
                           <TableColumn fx:id="equipmentNameColumn" prefWidth="220.0" text="Equipment" />
                           <TableColumn fx:id="equipmentTotalColumn" prefWidth="90.0" text="Total" />
                           <TableColumn fx:id="equipmentAvailableColumn" prefWidth="90.0" text="Available" />
                           <TableColumn fx:id="equipmentCheckedOutColumn" prefWidth="100.0" text="Checked Out" />
                           <TableColumn fx:id="equipmentMaintenanceColumn" prefWidth="100.0" text="Maintenance" />
