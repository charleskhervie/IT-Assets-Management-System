               <HBox spacing="12.0">
                  <children>
                     <VBox style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 4; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="Total Units" />
                           <Label fx:id="totalUnitsLabel" style="-fx-font-size: 24px; -fx-font-weight: 700;" text="0" />
                        </children>
                     </VBox>
                     <VBox style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 4; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="Available" />
                           <Label fx:id="availableUnitsLabel" style="-fx-font-size: 24px; -fx-font-weight: 700;" text="0" />
                        </children>
                     </VBox>
                     <VBox style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 12; -fx-background-radius: 4; -fx-border-radius: 4;" HBox.hgrow="ALWAYS">
                        <children>
                           <Label text="Checked Out" />
                           <Label fx:id="checkedOutUnitsLabel" style="-fx-font-size: 24px; -fx-font-weight: 700;" text="0" />
