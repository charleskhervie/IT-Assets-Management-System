               </VBox>

               <VBox spacing="10.0" style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-padding: 10;">
                  <children>
                     <Label text="Equipment Distribution">
                        <font>
                           <Font name="System Bold" size="16.0" />
                        </font>
                     </Label>
                     <BarChart fx:id="equipmentBarChart" prefHeight="300.0">
                        <xAxis>
                           <CategoryAxis label="Equipment" />
