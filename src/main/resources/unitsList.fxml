<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="620.0" prefWidth="1120.0" style="-fx-background-color: white;" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="view.controller.UnitsListScreen">
   <top>
      <VBox spacing="12.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="14.0" left="24.0" right="24.0" top="14.0" />
         </padding>
         <children>
            <HBox alignment="CENTER" prefHeight="48.0" style="-fx-background-color: #cfcfcf; -fx-border-color: #4a4a4a; -fx-border-width: 1;">
               <children>
                  <Label style="-fx-font-size: 22px; -fx-font-weight: 700;" text="UNITS LIST" />
               </children>
            </HBox>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
               <children>
                  <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Status:" />
                  <ComboBox fx:id="statusFilter" prefWidth="170.0" style="-fx-background-color: white; -fx-border-color: #4a4a4a;" />
                  <Region HBox.hgrow="ALWAYS" />
                  <Label style="-fx-font-size: 14px; -fx-font-weight: 700;" text="Search" />
                  <TextField fx:id="searchField" prefWidth="240.0" promptText="Search unit, equipment, category..." style="-fx-background-color: white; -fx-border-color: #4a4a4a;" />
               </children>
            </HBox>
         </children>
      </VBox>
   </top>
   <center>
      <VBox BorderPane.alignment="CENTER">
         <padding>
            <Insets left="24.0" right="24.0" />
         </padding>
         <children>
            <TableView fx:id="unitsTable" prefHeight="420.0" style="-fx-background-color: white; -fx-border-color: #4a4a4a; -fx-border-width: 1;">
               <columns>
                  <TableColumn fx:id="idColumn" prefWidth="70.0" text="ID" />
                  <TableColumn fx:id="serialColumn" prefWidth="170.0" text="Serial No." />
                  <TableColumn fx:id="equipmentColumn" prefWidth="210.0" text="Equipment" />
                  <TableColumn fx:id="categoryColumn" prefWidth="140.0" text="Category" />
                  <TableColumn fx:id="statusColumn" prefWidth="130.0" text="Status" />
                  <TableColumn fx:id="assignedToColumn" prefWidth="160.0" text="Assigned To" />
                  <TableColumn fx:id="actionsColumn" prefWidth="180.0" text="Actions" />
               </columns>
            </TableView>
         </children>
      </VBox>
   </center>
   <bottom>
      <HBox alignment="CENTER_RIGHT" spacing="14.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="22.0" left="24.0" right="24.0" top="18.0" />
         </padding>
         <children>
            <Button fx:id="checkOutButton" mnemonicParsing="false" onAction="#handleCheckOut" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #27AE60; -fx-text-fill: white;" text="Check-out" />
            <Button fx:id="checkInButton" mnemonicParsing="false" onAction="#handleCheckIn" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #27AE60; -fx-text-fill: white;" text="Check-in" />
            <Button fx:id="addUnitButton" mnemonicParsing="false" onAction="#handleAddUnit" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #27AE60; -fx-text-fill: white;" text="Add Unit" />
            <Button fx:id="addEquipmentButton" mnemonicParsing="false" onAction="#handleAddEquipment" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #27AE60; -fx-text-fill: white;" text="Add Equipment" />
            <Button fx:id="addCategoryButton" mnemonicParsing="false" onAction="#handleAddCategory" prefHeight="34.0" prefWidth="130.0" style="-fx-background-color: #27AE60; -fx-text-fill: white;" text="Add Category" />
            <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" prefHeight="34.0" prefWidth="110.0" text="Back" />
         </children>
      </HBox>
   </bottom>
</BorderPane>
